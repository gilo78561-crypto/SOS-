{
  "name": "@sos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently -k \"tsc -p tsconfig.json --watch\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "npm run build && node dist/cli.js migrate",
    "seed": "npm run build && node dist/cli.js seed"
  },
  "dependencies": {
    "@sos/contracts": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "zod": "^4.1.12"
  }
}
